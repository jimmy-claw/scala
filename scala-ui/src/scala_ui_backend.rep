class ScalaUiBackend
{
    // ── Identity ────────────────────────────────────────────────────────────
    SLOT(QString getIdentity())
    SLOT(void setIdentity(QString pubkeyHex))

    // ── Calendar CRUD ──────────────────────────────────────────────────────
    SLOT(QString createCalendar(QString name, QString color))
    SLOT(QString listCalendars())  // returns JSON array string
    SLOT(bool deleteCalendar(QString id))

    // ── Event CRUD ─────────────────────────────────────────────────────────
    SLOT(QString createEvent(QString calendarId, QString eventJson))
    SLOT(QString updateEvent(QString eventJson))
    SLOT(bool deleteEvent(QString id))
    SLOT(QString listEvents(QString calendarId))  // returns JSON array string
    SLOT(QString getEvent(QString id))

    // ── Sync / Sharing ─────────────────────────────────────────────────────
    SLOT(QString shareCalendar(QString calendarId))  // returns encryption key
    SLOT(bool joinSharedCalendar(QString calendarId, QString encryptionKey))
    SLOT(QString getSyncStatus(QString calendarId))  // "not_shared" | "syncing" | "offline"

    // ── Share Links ────────────────────────────────────────────────────────
    SLOT(QString generateShareLink(QString calendarId))
    SLOT(QString parseShareLink(QString link))  // returns JSON object string
    SLOT(bool handleShareLink(QString link))

    // ── Search ─────────────────────────────────────────────────────────────
    SLOT(QString searchEvents(QString query))  // returns JSON array string

    // ── Reminders ──────────────────────────────────────────────────────────
    SLOT(QString getPendingReminders())  // returns JSON array string

    // ── Settings ───────────────────────────────────────────────────────────
    SLOT(void setSetting(QString key, QString value))
    SLOT(QString getSetting(QString key, QString defaultValue))

    // ── PROPs — auto-synced backend → QML, no polling ──────────────────────
    // Current user identity (updated when identity changes)
    PROP(QString currentIdentity="" READONLY)

    // Pending reminders count (bumped by reminder checker)
    PROP(int pendingReminderCount=0 READONLY)

    // Active sync status for the selected calendar
    PROP(QString activeSyncStatus="not_shared" READONLY)

    // ── SIGNALS — backend → view push ──────────────────────────────────────
    // Emitted when identity changes (e.g. new device, key rotation)
    SIGNAL(identityChanged(QString newIdentity))

    // Emitted when pending reminders are detected
    SIGNAL(remindersAvailable(int count, QString details))

    // Emitted when sync status changes for a calendar
    SIGNAL(syncStatusChanged(QString calendarId, QString status))

    // Emitted when a shared calendar receives new events from peers
    SIGNAL(eventsSynced(QString calendarId, int eventCount))
}
